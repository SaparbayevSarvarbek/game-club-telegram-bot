# Telegram Bot Configuration
# ===========================

# Telegram bot tokeni (BotFather dan olingan)
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_here

# Admin chat ID (shaxsiy chat ID, backup va admin operatsiyalar uchun)
# Bot /start buyrug'ini shaxsiy chatda yuboring, bot sizga chat ID ni ko'rsatadi
# Format: raqam (masalan: 1929608756)
ADMIN_CHAT_ID=your_admin_chat_id_here

# Report chat ID (kunlik hisobotlar uchun guruh yoki supergroup ID)
# Bot guruhga qo'shing va /start buyrug'ini yuboring, bot sizga chat ID ni ko'rsatadi
# Supergroup uchun format: manfiy raqam (masalan: -1001234567890)
# Agar kiritilmasa, ADMIN_CHAT_ID ishlatiladi
REPORT_CHAT_ID=your_report_chat_id_here

# Backend API URL
# Production: https://game-club-backend.onrender.com/api
# Local: http://localhost:8000/api
BACKEND_API_URL=https://game-club-backend.onrender.com/api

# Database URL (Render.com avtomatik o'rnatadi)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=your_database_url_here

# HTTP Server Port (Render.com avtomatik o'rnatadi, default: 3000)
PORT=10000

# ===========================
# CHAT ID NI QANDAY TOPISH
# ===========================
#
# 1. Shaxsiy chat ID (ADMIN_CHAT_ID):
#    - Botga shaxsiy chatda /start buyrug'ini yuboring
#    - Bot sizga chat ID ni ko'rsatadi
#
# 2. Guruh/Supergroup chat ID (REPORT_CHAT_ID):
#    - Botni guruhga qo'shing
#    - Guruhda /start buyrug'ini yuboring
#    - Bot chat ID ni ko'rsatadi
#    - Supergroup uchun ID manfiy va -100 bilan boshlanadi
#
# 3. Agar group supergroup ga o'tkazilgan bo'lsa:
#    - Eski chat ID ("-4853010931" kabi) ishlamaydi
#    - Yangi supergroup ID kerak ("-1001234567890" formatida)
#    - Botni yangi supergroup da /start qiling
#    - Yangi chat ID ni REPORT_CHAT_ID ga kiriting
